<!-- ============ 03 作品仓库 ============ -->
<section class="sec" id="work">
	<div class="wrap">
		<div class="sec-head" data-rv>
			<span class="sec-no">03 / 作品</span>
			<h2>一起写出来的仓库</h2>
			<span class="sec-cmd">// 点开任意一个，都是一段还在继续的合作</span>
		</div>

		<div class="feat" data-rv>
			<div class="feat-main">
				<div class="feat-tags">
					<span class="badge"><i class="dot"></i><span id="featStatus"></span></span>
					<span class="feat-flag">FEATURED · 合作最深的一段</span>
				</div>
				<h3 id="featName"></h3>
				<span class="feat-slug" id="featSlug"></span>
				<p class="feat-one" id="featOne"></p>
				<p class="feat-partner" id="featPartner"></p>
				<p class="feat-lead" id="featLead"></p>
				<button class="btn line" id="featBtn">打开这个仓库
					<svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"/><path d="M13 6l6 6-6 6"/></svg></button>
			</div>
			<div class="feat-side">
				<div class="fs-block">
					<div class="fs-t">commit 热力图 · 最近半年</div>
					<div class="heat" id="featHeat"></div>
					<div class="fs-stats" id="featStats"></div>
				</div>
			</div>
		</div>

		<div class="repo-list" id="repoList"></div>
	</div>
</section>
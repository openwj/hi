				var errShown = false;
				function reportErr(tag, err) {
					try {
						console.error('[wodema] 模块「' + tag + '」初始化失败：', err);
						if (!errShown) {
							errShown = true;
							var t = document.getElementById('toast');
							if (t) {
								t.textContent = '页面部分功能出了点问题：' + tag + '。按 F12 打开控制台，把红色报错发给我即可修复';
								t.classList.add('on');
							}
						}
					} catch (_) {}
				}
				window.addEventListener('error', function (e) { if (e && e.message) reportErr('脚本运行', e.message); });
				function boot(tag, fn) { try { fn(); } catch (err) { reportErr(tag, err); } }

				/* ================= 工具 ================= */
				function $(s) { return document.querySelector(s); }

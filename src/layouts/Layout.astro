						var bp = mk('path', { class: 'gg-branch', d: 'M' + mx + ' ' + y0 + ' C ' + (mx + 96) + ' ' + y0 + ', ' + (mx + 134) + ' ' + (y0 + 14) + ', ' + (mx + 134) + ' ' + (y0 + 52) + ' C ' + (mx + 134) + ' ' + (y0 + 90) + ', ' + (mx + 96) + ' ' + y1 + ', ' + mx + ' ' + y1 });
						svg.appendChild(bp);
						var n1 = mk('circle', { class: 'gg-node', cx: mx, cy: y0, r: 5 });
						var n2 = mk('circle', { class: 'gg-node gg-merge', cx: mx, cy: y1, r: 5 });
						svg.appendChild(n1); svg.appendChild(n2);
						var t1 = mk('text', { class: 'gg-name gg-fade', x: mx + 152, y: y0 + 42 });
						var t2 = mk('text', { class: 'gg-meta gg-fade', x: mx + 152, y: y0 + 62 });
						var t3 = mk('text', { class: 'gg-st gg-fade', x: mx + 152, y: y0 + 82 });
						t1.textContent = p.name; t2.textContent = p.period + ' · 与' + p.partner; t3.textContent = p.one;
						svg.appendChild(t1); svg.appendChild(t2); svg.appendChild(t3);
						var hit = mk('rect', { class: 'gg-hit gg-fade', x: mx + 142, y: y0 + 18, width: 420, height: 76 });
						var title = document.createElementNS(NS, 'title'); title.textContent = '查看 ' + p.name + ' 详情';
						hit.appendChild(title); svg.appendChild(hit);
						[t1, t2, t3, hit].forEach(function (n) { n.addEventListener('click', function () { openRepo(p); }); });
						var yr = p.start.slice(0, 4);
						if (yr !== lastYear) { lastYear = yr; var yt = mk('text', { class: 'gg-year', x: mx - 18, y: y0 + 4 }); yt.textContent = yr; svg.appendChild(yt); }
						[t1, t2, t3, hit, n1, n2].forEach(function (n) { n.style.transitionDelay = (0.25 + i * 0.18 + 0.35) + 's'; });
						bp.style.transitionDelay = (0.25 + i * 0.18) + 's';
					});
					var head = mk('circle', { class: 'gg-node gg-head', cx: mx, cy: endY, r: 6 });
					var ht = mk('text', { class: 'gg-meta gg-fade', x: mx + 18, y: endY + 4 });
					ht.textContent = 'HEAD → 主线 · 还在继续写';
					svg.appendChild(head); svg.appendChild(ht);

					requestAnimationFrame(function () {
						$$('#graphSvg .gg-master, #graphSvg .gg-branch').forEach(function (p) {
							var L = p.getTotalLength();
							p.style.strokeDasharray = L; p.style.strokeDashoffset = L;
							p.style.transitionProperty = 'stroke-dashoffset';
							p.style.transitionDuration = '1s';
							p.style.transitionTimingFunction = 'ease';
						});
					});
					var wrap = $('#graphWrap');
					if (wrap && 'IntersectionObserver' in window) {
						new IntersectionObserver(function (es, o) {
							es.forEach(function (e) {
								if (e.isIntersecting) {
									wrap.classList.add('in'); o.disconnect();
									$$('#graphSvg .gg-master, #graphSvg .gg-branch').forEach(function (p) { p.style.strokeDashoffset = 0; });
								}
							});
						}, { threshold: .2 }).observe(wrap);
					} else if (wrap) {
						wrap.classList.add('in');
						$$('#graphSvg .gg-master, #graphSvg .gg-branch').forEach(function (p) { p.style.strokeDashoffset = 0; });
					}
				});

				/* ================= PR 表单 ================= */
				boot('PR表单', function () {
					var chips = $('#stageChips');
					if (chips) chips.addEventListener('click', function (e) {
						var c = e.target.closest('.chip'); if (!c) return;
						$$('#stageChips .chip').forEach(function (x) { x.classList.remove('on'); });
						c.classList.add('on');
					});
					var form = $('#prForm'); if (!form) return;
					var prMask = $('#prMask');
					var prBriefText = '', prSubject = '';
					form.addEventListener('submit', function (e) {
						e.preventDefault();
						var tEl = $('#prTitle');
						var t = tEl ? tEl.value.trim() : '';
						if (!t) {
							if (tEl) { tEl.classList.add('err'); tEl.focus(); setTimeout(function () { tEl.classList.remove('err'); }, 1200); }
							toast('先写一句：我想做一个 XXX');
							return;
						}
						var onChip = $('#stageChips .chip.on');
						var stage = (onChip && onChip.dataset) ? onChip.dataset.v : '只有一个想法';
						var bEl = $('#prBody');
						var body = bEl ? bEl.value.trim() : '';
						var no = 100 + Math.floor(Math.random() * 900);
						var d = new Date();
						var date = d.getFullYear() + '.' + String(d.getMonth() + 1).padStart(2, '0') + '.' + String(d.getDate()).padStart(2, '0');
					prBriefText = '【想做的事】\n' + t + '\n\n【当前阶段】\n' + stage + '\n\n【补充】\n' + (body || '（细节见面聊）') + '\n\n—— 来自 我的码 站点 · ' + date;
						prSubject = 'PR #' + no + '：' + t;
						var noEl = $('#prNo'); if (noEl) noEl.textContent = 'PR #' + no + ' 已打开';
						var br = $('#prBrief'); if (br) br.textContent = prBriefText;
						if (prMask) openMask(prMask);
						form.reset();
						$$('#stageChips .chip').forEach(function (x, i) { x.classList.toggle('on', i === 0); });
						toast('PR 已创建，复制简介或直接发邮件');
					});
					var pc = $('#prCopy');
					if (pc) pc.addEventListener('click', function () { copyText(prBriefText, '简介已复制，去私信里粘贴吧'); });
					var pm = $('#prMail');
					if (pm) pm.addEventListener('click', function () {
						location.href = 'mailto:' + MAIL + '?subject=' + encodeURIComponent(prSubject) + '&body=' + encodeURIComponent(prBriefText);
					});
					var mb = $('#mailBtn');
					if (mb) mb.addEventListener('click', function () { copyText(MAIL, '邮箱已复制：' + MAIL); });
					var xb = $('#xhsBtn');
					if (xb) xb.addEventListener('click', function () { copyText(XHS, '小红书号已复制：' + XHS); });
				});

				/* ================= 命令面板 ================= */
				boot('命令面板', function () {
					var palMask = $('#palMask'), palInput = $('#palInput'), palList = $('#palList'), palBtn = $('#palBtn');
					if (!palMask || !palInput || !palList) return;
					var palIdx = 0, curCmds = [];
					var COMMANDS = [
						{ k: '前往 · 合作方式', h: '#diff', run: function () { go('#diff'); } },
						{ k: '前往 · 适合谁', h: '#who', run: function () { go('#who'); } },
						{ k: '前往 · 作品仓库', h: '#work', run: function () { go('#work'); } },
						{ k: '前往 · 投入方式', h: '#modes', run: function () { go('#modes'); } },
						{ k: '前往 · 合作流程', h: '#how', run: function () { go('#how'); } },
						{ k: '前往 · 合作轨迹', h: '#path', run: function () { go('#path'); } },
						{ k: '前往 · 伙伴的话', h: '#voices', run: function () { go('#voices'); } },
						{ k: '前往 · 关于我', h: '#about', run: function () { go('#about'); } },
						{ k: '前往 · 常见问题', h: '#faq', run: function () { go('#faq'); } },
						{ k: '前往 · 发一个 Pull Request', h: '#pr', run: function () { go('#pr'); setTimeout(function () { var el = $('#prTitle'); if (el) el.focus(); }, 700); } },
						{ k: '动作 · 复制邮箱', h: 'copy', run: function () { copyText(MAIL, '邮箱已复制：' + MAIL); } },
						{ k: '动作 · 复制小红书号', h: 'copy', run: function () { copyText(XHS, '小红书号已复制：' + XHS); } },
						{ k: '动作 · 随机打开一个项目', h: 'repo', run: function () { openRepo(PROJECTS[Math.floor(Math.random() * PROJECTS.length)]); } },
						{ k: '动作 · 回到顶部', h: 'top', run: function () { window.scrollTo({ top: 0, behavior: 'smooth' }); } }
					];
					function paintAct() {
						palList.querySelectorAll('li[data-i]').forEach(function (li) { li.classList.toggle('act', +li.dataset.i === palIdx); });
					}
					function renderPal(q) {
						curCmds = COMMANDS.filter(function (c) { return c.k.indexOf(q) > -1 || c.h.indexOf(q) > -1; });
						if (palIdx >= curCmds.length) palIdx = Math.max(0, curCmds.length - 1);
						palList.innerHTML = curCmds.length
							? curCmds.map(function (c, i) { return '<li class="' + (i === palIdx ? 'act' : '') + '" data-i="' + i + '"><span>' + c.k + '</span><i>' + c.h + '</i></li>'; }).join('')
							: '<li class="empty">没有匹配的命令</li>';
						palList.querySelectorAll('li[data-i]').forEach(function (li) {
							li.addEventListener('click', function () { curCmds[+li.dataset.i].run(); closeMask(palMask); });
							li.addEventListener('mousemove', function () { palIdx = +li.dataset.i; paintAct(); });
						});
					}
					function openPal() { palInput.value = ''; palIdx = 0; renderPal(''); openMask(palMask); setTimeout(function () { palInput.focus(); }, 30); }
					if (palBtn) palBtn.addEventListener('click', openPal);
					palInput.addEventListener('input', function () { palIdx = 0; renderPal(palInput.value.trim()); });

					[repoMask, $('#prMask'), palMask].forEach(function (m) {
						if (m) m.addEventListener('click', function (e) { if (e.target === m) closeMask(m); });
					});
					document.addEventListener('keydown', function (e) {
						if (e.key === 'Escape') { $$('.mask.on').forEach(closeMask); return; }
						if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
							e.preventDefault();
							if (palMask.classList.contains('on')) closeMask(palMask); else openPal();
							return;
						}
						if (palMask.classList.contains('on')) {
							if (e.key === 'ArrowDown') { e.preventDefault(); palIdx = Math.min(curCmds.length - 1, palIdx + 1); paintAct(); }
							else if (e.key === 'ArrowUp') { e.preventDefault(); palIdx = Math.max(0, palIdx - 1); paintAct(); }
							else if (e.key === 'Enter' && curCmds[palIdx]) { e.preventDefault(); curCmds[palIdx].run(); closeMask(palMask); }
							return;
						}
						var tag = (document.activeElement && document.activeElement.tagName) || '';
						if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') { e.preventDefault(); openPal(); }
					});
				});

				/* ================= 滚动浮现 / 计数 / 导航 ================= */
				boot('滚动动效', function () {
					if (!('IntersectionObserver' in window)) {
						$$('[data-rv], .diffwin, .rr').forEach(function (el) { el.classList.add('in'); });
						return;
					}
					var rvIO = new IntersectionObserver(function (es) {
						es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); rvIO.unobserve(en.target); } });
					}, { threshold: .15 });
					$$('[data-rv], .diffwin, .rr').forEach(function (el) { rvIO.observe(el); });

					var cntIO = new IntersectionObserver(function (es) {
						es.forEach(function (en) {
							if (!en.isIntersecting) return;
							cntIO.unobserve(en.target);
							var el = en.target, target = +el.dataset.count, t0 = performance.now();
							(function f(t) {
								var k = Math.min(1, (t - t0) / 1400), e2 = 1 - Math.pow(1 - k, 3);
								el.textContent = Math.round(target * e2).toLocaleString('en-US');
								if (k < 1) requestAnimationFrame(f);
							})(t0);
						});
					}, { threshold: .4 });
					$$('[data-count]').forEach(function (el) { cntIO.observe(el); });

					var navIO = new IntersectionObserver(function (es) {
						es.forEach(function (en) {
							if (en.isIntersecting) {
								$$('#nav a').forEach(function (a) { a.classList.toggle('on', a.dataset.s === en.target.id); });
							}
						});
					}, { rootMargin: '-40% 0px -55% 0px' });
					$$('section[id]').forEach(function (s) { navIO.observe(s); });
				});

				boot('顶栏状态', function () {
					var top = $('#top'); if (!top) return;
					window.addEventListener('scroll', function () {
						top.classList.toggle('scrolled', window.scrollY > 24);
					}, { passive: true });
				});

				/* 邮箱文案还原：把 [at]/[dot] 写成真地址，人看正常，爬虫抓不到 */
				boot('邮箱还原', function () {
					$$('[data-mail-label]').forEach(function (el) { el.textContent = MAIL; });
				});
			})();
		</script>
	</body>
</html>
				/* ================= 热力图 / 脉冲 ================= */
				function heat(el, seed, cols, rows) {
					if (!el) return;
					var rnd = mulberry32(seed), html = '';
					for (var i = 0; i < cols * rows; i++) {
						var r = rnd(), lv = r < .3 ? 0 : r < .55 ? 1 : r < .75 ? 2 : r < .9 ? 3 : 4;
						html += '<i class="hc" data-l="' + lv + '"></i>';
					}
					el.innerHTML = html;
					el.style.gridTemplateRows = 'repeat(' + rows + ',var(--cell))';
				}
				function pulse(el, seed, n) {
					if (!el) return;
					n = n || 44;
					var rnd = mulberry32(seed), html = '';
					for (var i = 0; i < n; i++) {
						var h = 4 + Math.round(rnd() * 26);
						html += '<i class="pb' + (i === n - 1 ? ' now' : '') + '" style="height:' + h + 'px"></i>';
					}
					el.innerHTML = html;
				}

				/* ================= 终端 ================= */
				var sceneI = 0, tkToken = 0;
				function runScene() {
					var body = $('#termBody'); if (!body) return;
					var my = ++tkToken, alive = function () { return my === tkToken; };
					var s = SCENES[sceneI % SCENES.length];
					body.innerHTML = '';
					var line = document.createElement('div'); line.className = 't-line';
					line.innerHTML = '<span class="t-p">❯</span><span class="t-c"></span><span class="t-cur"></span>';
					body.appendChild(line);
					var c = line.querySelector('.t-c'), i = 0;
					(function ty() {
						if (!alive()) return;
						if (i < s.cmd.length) { c.textContent += s.cmd[i++]; return setTimeout(ty, 30 + Math.random() * 50); }
						var cur = line.querySelector('.t-cur'); if (cur) cur.remove();
						var j = 0;
						(function nx() {
							if (!alive()) return;
							if (j < s.out.length) {
								var o = document.createElement('div'); o.className = 't-line ' + s.out[j][1];
								o.textContent = s.out[j][0]; j++;
								body.appendChild(o);
								return setTimeout(nx, 180);
							}
							setTimeout(function () { if (alive()) { sceneI++; runScene(); } }, 3400);
						})();
					})();
				}
				boot('终端', function () {
					var t = $('#term');
					if (t) t.addEventListener('click', function () { sceneI++; runScene(); });
					runScene();
				});


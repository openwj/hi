				var mult = onComp ? +onComp.getAttribute('data-m') : 1;
				var lab = onComp ? onComp.getAttribute('data-l') : '标准';
				if (days === 0) { hint.style.display = ''; bodyEl.hidden = true; return; }
				hint.style.display = 'none'; bodyEl.hidden = false;
				var d = Math.max(1, Math.round(days * mult));
				var wks = Math.round(d / 5 * 10) / 10;
				wks = (wks % 1 === 0 ? wks.toFixed(0) : wks.toFixed(1));
				$('#estDays').textContent = d;
				$('#estWeeks').textContent = wks;
				$('#estPrice').textContent = '¥' + fmt(round100(d * EST_RATE * 0.85)) + ' – ¥' + fmt(round100(d * EST_RATE * 1.15));
				$('#estNote').textContent = '按起步单价 ¥' + fmt(EST_RATE) + '/人天、复杂度「' + lab + '」计算（手作坊价）。实际报价以聊完的范围清单为准——误差通常在 ±30% 内。砍范围，别砍价。';
			}
			wrap.addEventListener('click', function (e) { var c = e.target.closest('.echip'); if (!c) return; c.classList.toggle('on'); calc(); });
			comp.addEventListener('click', function (e) {
				var b = e.target.closest('.ec'); if (!b) return;
				comp.querySelectorAll('.ec').forEach(function (x) { x.classList.remove('on'); });
				b.classList.add('on'); calc();
			});
			var rs = $('#estReset');
			if (rs) rs.addEventListener('click', function () {
				wrap.querySelectorAll('.echip').forEach(function (x) { x.classList.remove('on'); });
				comp.querySelectorAll('.ec').forEach(function (x) { x.classList.toggle('on', x.getAttribute('data-m') === '1'); });
				calc();
			});
		});

		/* ========== 成熟期滑块 ========== */
		boot('成熟期图示', function () {
			var grid = $('#vestGrid'), range = $('#vestRange'), cap = $('#vestCap');
			if (!grid || !range || !cap) return;
			var cells = [];
			for (var i = 0; i < 36; i++) {
				var c = document.createElement('div');
				c.className = 'vcell';
				grid.appendChild(c);
				cells.push(c);
			}
			function paint() {
				var v = +range.value;
				cells.forEach(function (c, i) { c.classList.toggle('on', i < v); });
				if (v === 0) { cap.innerHTML = '还没开始 · 成熟 <b>0%</b> · 全部按协议处理'; }
				else {
					var pct = Math.round(v / 36 * 1000) / 10;
					cap.innerHTML = '拖到第 <b>' + v + '</b> / 36 个月 · 已成熟 <b>' + pct + '%</b> · 未成熟部分按协议收回';
				}
			}
			range.addEventListener('input', paint);
			paint();
		});

		/* ========== FAQ 手风琴（全页通用） ========== */
		boot('FAQ', function () {
			once('faq', function () {
				document.addEventListener('click', function (e) {
					var q = e.target.closest('.fq-q'); if (!q) return;
					var fq = q.parentElement, wasOpen = fq.classList.contains('open');
					var box = fq.parentElement;
					if (box) box.querySelectorAll('.fq').forEach(function (x) { x.classList.remove('open'); });
					if (!wasOpen) fq.classList.add('open');
				});
			});
		});

		/* ========== 复制邮箱 / 顶栏 / 浮现 ========== */
		boot('联系', function () {
			once('mail', function () {
				var m = $('#mailBtn');
				if (m) m.addEventListener('click', function () { copyText(MAIL, '邮箱已复制：' + MAIL); });
			});
		});
		boot('顶栏', function () {
			once('top', function () {
				var top = $('#top'); if (!top) return;
				window.addEventListener('scroll', function () { top.classList.toggle('scrolled', window.scrollY > 24); }, { passive: true });
			});
		});
		boot('移动端菜单', function () {
			once('burger', function () {
				var burger = $('#burger'), mNav = $('#mNav');
				if (!burger || !mNav) return;
				function setOpen(on) {
					burger.classList.toggle('on', on);
					mNav.classList.toggle('on', on);
					burger.setAttribute('aria-expanded', on ? 'true' : 'false');
					burger.setAttribute('aria-label', on ? '关闭菜单' : '打开菜单');
				}
				burger.addEventListener('click', function () { setOpen(!burger.classList.contains('on')); });
				mNav.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
				document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
			});
		});
		boot('浮现动效', function () {
			once('reveal', function () {
				var els = $$('[data-rv]');
				if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('in'); }); return; }
				var io = new IntersectionObserver(function (es) {
					es.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
				}, { threshold: .12 });
				els.forEach(function (el) { io.observe(el); });
			});
		});
		/* 邮箱文案还原：把 [at]/[dot] 写成真地址，人看正常，爬虫抓不到 */
		boot('邮箱还原', function () {
			once('mailLabel', function () {
				$$('[data-mail-label]').forEach(function (el) { el.textContent = MAIL; });
			});
		});
	})();
</script>